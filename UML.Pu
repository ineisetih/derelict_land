@startuml name
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Character {
  - name: String
  - health: float
  - damage: float
  - level: int
  - inventory: IInventory*
  + Character(name: String, health: float, damage: float)
  + Attack(target: Character*)
  + Take_Damage(damage: float)
  + Heal(heal: float)
  + GetName(): String
  + GetHealth(): float
  + GetDamage(): float
}

class Player {
  - experience: float
  - level: int
  - instance: Player*
  + Player(name: String, health: float, damage: float)
  + ~Player()
  + CreatePlayer(name: String, health: float, damage: float): Player*
  + AddExperience(exp: float)
  + GetExperience(): float
  + GetLevel(): int
  + LevelUp()
  + AddLevel(levels: int)
  + EquipWeapon(weapon: IItem)
  + EquipArmor(armor: IItem)
  + AddItemToBackpack(item: IItem)
  + RemoveItemFromBackpack(item: IItem)
  + GetInventoryInfo(): String
  + SetHealth(health: float)
  + SetDamage(damage: float)
}

class NPC {
  + NPC(name: String, health: float, damage: float)
  + Interact()
}

class Merchant {
  + Merchant(name: String, health: float, damage: float)
  + Interact()
}

class Enemy {
  - defence: float
  - given_exp: float
  + Enemy(name: String, health: float, damage: float, defence: float, given_exp: float)
  + DropLoot(): IItem
  + GetDefence(): float
  + GetGivenExp(): float
}

class EnemyFactory {
  + CreateEnemy(type: EnemyType): Enemy
}

enum EnemyType {
  Goblin
  Skeleton
}

interface IItem {
  + GetInfo(): String
  + GetType(): ItemType
}

enum ItemType {
  OneHandWeapon
  BodyArmor
  AttackGem
}

class Weapon {
  - name: String
  - damage: float
  - number_of_gem_slots: size_t
  - gems: vector<Gem*>
  + Weapon(name: String, damage: float, slots: size_t)
  + ~Weapon()
  + GetInfo(): String
  + GetDamage(): float
  + AddGem(gem: Gem)
  + RemoveGem(gem: Gem)
}

class Sword {
  - type: ItemType
  + Sword(name: String, damage: float, slots: size_t, gems: vector<Gem*>)
  + GetInfo(): String
  + GetType(): ItemType
}

class Armor {
  - name: String
  - gems: vector<Gem*>
  - defence: float
  - number_of_gem_slots: size_t
  + Armor(name: String, defence: float, slots: size_t)
  + ~Armor()
  + GetInfo(): String
  + AddGem(gem: Gem)
  + RemoveGem(gem: Gem)
}

class Chestplate {
  - type: ItemType
  + Chestplate(name: String, defence: float, slots: size_t)
  + GetType(): ItemType
}

class Gem {
  - type: ItemType
  - name: String
  - bonus: float
  + Gem(name: String, type: ItemType, bonus: float)
  + GetBonus(): float
  + GetType(): ItemType
  + GetInfo(): String
}

class ItemGenerator {
  + GenerateItem(): IItem
}

interface IInventory {
  + GetInfo(): String
  + AddItem(item: IItem)
  + RemoveItem(item: IItem)
}

class PlayerInventory {
  - left_hand: IItem
  - right_hand: IItem
  - body: IItem
  - backpack: vector<IItem>
  + PlayerInventory()
  + ~PlayerInventory()
  + AddItem(item: IItem)
  + EquipWeapon(weapon: IItem): bool
  + EquipArmor(armor: IItem): bool
  + RemoveItem(item: IItem)
  + GetInfo(): String
}

class PlayerGetItem {
  + Execute(item: IItem)
}

class GetItemFromShop {
  + Execute(item_index: int): IItem
}

interface ICommand {
  + CommandExecute()
}

class ShowInventoryCommand {
  + CommandExecute()
}

class ExploreCommand {
  + CommandExecute()
}

class OpenShopCommand {
  + CommandExecute()
}

class BuyCommand {
  + CommandExecute()
}

class EscapeCommand {
  + CommandExecute()
}

class FightCommand {
  + CommandExecute()
}

class Exit {
  + CommandExecute()
}

class ShowCommandsList {
  - logic: DefaultLogic
  + ShowCommandsList(logic: DefaultLogic)
  + CommandExecute()
}

class ShowPlayerStats {
  + CommandExecute()
}

class NewGame {
  + CommandExecute()
}

class LoadGameCommand {
  + CommandExecute()
}

class ListSavesCommand {
  + CommandExecute()
}

class CommandHandler {
  - instance: CommandHandler
  + GetInstance(): CommandHandler
  + ExecuteCommand(command: String)
}

class DefaultLogic {
  - commands: unordered_map<String, ICommand*>
  + DefaultLogic()
  + DoCommand(console_command: String)
  + GetCommands(): unordered_map<String, ICommand*>
  + AddCommand(command_name: String, command: ICommand*)
}

class TownLogic {
  - TownLogicInstance: TownLogic
  + GetInstance(): TownLogic
}

class ShopLogic {
  - ShopLogicInstance: ShopLogic
  - commoditys: vector<IItem*>
  + GetInstance(): ShopLogic
  + GetCommoditys(): vector<IItem*>
  + OnShopOpen()
}

class FightLogic {
  - MainFightLogicInstance: FightLogic
  - enemies: vector<Enemy*>
  + GetInstance(): FightLogic
  + AddEnemy(enemy: Enemy*)
  + RemoveEnemy(enemy: Enemy*)
  + CreateEnemies()
  + GetEnemies(): vector<Enemy*>
  + StartFight()
}

class LogicHandler {
  - LogicHandlerInstance: LogicHandler
  + GetInstance(): LogicHandler
  + ChangeLogic(new_logic: DefaultLogic*)
}

class MainMenuLogic {
  - MainMenuLogicInstance: MainMenuLogic
  + GetInstance(): MainMenuLogic
}

class GameMaster {
  - instance: GameMaster
  - player: Player*
  - currentLogic: DefaultLogic*
  + GetInstance(): GameMaster
  + SetPlayer(player: Player*)
  + GetPlayer(): Player*
  + SetCurrentLogic(logic: DefaultLogic*)
  + GetCurrentLogic(): DefaultLogic*
}

class GiveLoot {
  + Execute(loot: vector<IItem*>)
}

class OnPlayerDeath {
  + Execute()
}

class SaveManager {
  + SaveGame(player: Player*)
  + LoadGame(name: String): PlayerSave*
  + ListSaves(): vector<String>
}

class PlayerSave {
    + name: String
    + health: float
    + damage: float
    + experience: float
    + level: int
}

class GameInitialisation {
    + StartGame()
}

' Relationships
Character <|-- Player : inheritance
Character <|-- NPC : inheritance
NPC <|-- Merchant : inheritance
Character <|-- Enemy : inheritance
IItem <|-- Weapon : inheritance
IItem <|-- Armor : inheritance
IItem <|-- Gem : inheritance
Weapon <|-- Sword : inheritance
Armor <|-- Chestplate : inheritance
IInventory <|-- PlayerInventory : inheritance
ICommand <|-- ShowInventoryCommand : inheritance
ICommand <|-- ExploreCommand : inheritance
ICommand <|-- OpenShopCommand : inheritance
ICommand <|-- BuyCommand : inheritance
ICommand <|-- EscapeCommand : inheritance
ICommand <|-- FightCommand : inheritance
ICommand <|-- Exit : inheritance
ICommand <|-- ShowCommandsList : inheritance
ICommand <|-- ShowPlayerStats : inheritance
ICommand <|-- NewGame : inheritance
ICommand <|-- LoadGameCommand : inheritance
ICommand <|-- ListSavesCommand : inheritance
DefaultLogic <|-- TownLogic : inheritance
DefaultLogic <|-- ShopLogic : inheritance
DefaultLogic <|-- FightLogic : inheritance
DefaultLogic <|-- MainMenuLogic : inheritance

Player "1" -- "1" PlayerInventory 
Player "1" -- "0..*" PlayerSave
GameMaster "1" -- "0..1" Player 
GameMaster "1" -- "0..1" DefaultLogic 
LogicHandler "1" -- "1" GameMaster
CommandHandler "1" -- "1" GameMaster 
DefaultLogic "1" -- "*" ICommand 
FightLogic "1" -- "*" Enemy 
GiveLoot "1" -- "*" IItem 
PlayerGetItem "1" -- "1" Player
GetItemFromShop "1" -- "1" ShopLogic 
ShowCommandsList "1" -- "1" DefaultLogic 
ExploreCommand "1" -- "1" LogicHandler 
OpenShopCommand "1" -- "1" ShopLogic 
BuyCommand "1" -- "1" GetItemFromShop 
BuyCommand "1" -- "1" PlayerGetItem 
FightCommand "1" -- "1" FightLogic 
EscapeCommand "1" -- "1" TownLogic 
OnPlayerDeath "1" -- "1" MainMenuLogic 
LoadGameCommand "1" -- "1" SaveManager 
NewGame "1" -- "1" SaveManager 
ListSavesCommand "1" -- "1" SaveManager 
EnemyFactory "1" -- "*" Enemy 
Weapon "1" -- "*" Gem 
Armor "1" -- "*" Gem 
Player "1" -- "1" SaveManager 
Player "1" -- "1" PlayerInventory 
Player "1" -- "1" PlayerGetItem 
Player "1" -- "1" OnPlayerDeath 
Player "1" -- "1" ShowPlayerStats 
Player "1" -- "1" ShowInventoryCommand 
Player "1" -- "1" FightLogic 
Player "1" -- "1" GiveLoot 
GameInitialisation "1" -- "1" MainMenuLogic 
GameInitialisation "1" -- "1" GameMaster 
GameInitialisation "1" -- "1" CommandHandler 
GameInitialisation "1" -- "1" LogicHandler 
GameInitialisation "1" -- "1" Player 
Player "1" -- "0..*" Enemy 
Player "1" -- "0..*" IItem 
Player "1" -- "0..*" NPC 
Player "1" -- "0..*" Merchant 
Enemy "1" -- "0..*" Player 
Merchant "1" -- "0..*" Player 
NPC "1" -- "0..*" Player 
ShopLogic "1" -- "0..*" Player 
FightLogic "1" -- "0..*" Player 
TownLogic "1" -- "0..*" Player 
MainMenuLogic "1" -- "0..*" Player 
GameMaster "1" -- "*" Character
GameMaster "1" -- "*" IItem
GameMaster "1" -- "*" ICommand 
GameMaster "1" -- "*" DefaultLogic 
GameMaster "1" -- "*" LogicHandler 
GameMaster "1" -- "*" SaveManager 
GameMaster "1" -- "*" GameInitialisation 
GameMaster "1" -- "*" PlayerInventory 
GameMaster "1" -- "*" PlayerGetItem 
GameMaster "1" -- "*" GetItemFromShop 
GameMaster "1" -- "*" GiveLoot 
GameMaster "1" -- "*" OnPlayerDeath 
GameMaster "1" -- "*" EnemyFactory 
GameMaster "1" -- "*" ItemGenerator 
ItemGenerator "1" -- "*" FightLogic 
ItemGenerator "1" -- "*" ShopLogic 
ItemType -- "*" IItem 
EnemyType -- "*" Enemy

@enduml
