@startuml name
!define LIGHTBLUE #E0FFFF

package "Game Core" {
  class GameMaster {
    - instance: GameMaster
    - current_player: Player
    - current_logic: DefaultLogic
    - director: Director
    + GetInstance(): GameMaster
    + InitializePlayer(): void
    + GetPlayer(): Player
    + GetCurrentLogic(): DefaultLogic
    + SetCurrentLogic(logic: DefaultLogic): void
    + GetDirector(): Director
  }

  class Director {
    - story_points: int
    + GetStoryPoints(): int
    + SetStoryPoints(points: int): void
  }

  class CommandHandler {
    - instance: CommandHandler
    + GetInstance(): CommandHandler
    + ExecuteCommand(command: string): void
  }
}

package "Characters & NPCs" {
  abstract class Character {
    # name: string
    # health: float
    # damage: float
    # level: int
    # inventory: IInventory
    + Character(name: string, health: float, damage: float)
    + Attack(target: Character): void
    + Take_Damage(damage: float): void
    + Heal(heal: float): void
    + GetName(): string
    + GetHealth(): float
    + GetDamage(): float
  }

  class Player {
    - experience: float
    - level: int
    - instance: Player
    + CreatePlayer(name: string, health: float, damage: float): Player
    + AddExperience(exp: float): void
    + GetExperience(): float
    + GetLevel(): int
    + LevelUp(): void
    + AddLevel(levels: int): void
    + EquipWeapon(weapon: Weapon): void
    + EquipArmor(armor: Armor): void
    + GetInventoryInfo(): string
    + SetHealth(health: float): void
    + SetDamage(damage: float): void
  }

  class NPC {
    + NPC(name: string, health: float, damage: float)
    + Interact(): void
  }

  class Merchant {
    + Merchant(name: string, health: float, damage: float)
    + Interact(): void
  }

  class Enemy {
    + Enemy(name: string, health: float, damage: float)
    + DropLoot(): void
  }

  enum EnemyType {
    Goblin
    Skeleton
  }

  class EnemyFactory {
    + CreateEnemy(type: EnemyType): Enemy
  }
}

package "Items & Inventory" {
  interface IItem {
    + GetInfo(): string
  }

  class Gem {
    - type: string
    - bonus: float
    + Gem(type: string, bonus: float)
    + GetBonus(): float
    + GetType(): string
    + GetInfo(): string
  }

  abstract class Weapon {
    # name: string
    # damage: float
    # number_of_gem_slots: size_t
    # gems: Gem[]
    + Weapon(name: string, damage: float, slots: size_t)
    + GetInfo(): string
    + AddGem(gem: Gem): void
    + RemoveGem(gem: Gem): void
  }

  class Sword {
    + Sword(name: string, damage: float, slots: size_t, gems: Gem[])
    + GetInfo(): string
  }

  abstract class Armor {
    # name: string
    # gems: Gem[]
    # defence: float
    # number_of_gem_slots: size_t
    + Armor(name: string, defence: float, slots: size_t)
    + GetInfo(): string
    + AddGem(gem: Gem): void
    + RemoveGem(gem: Gem): void
  }

  interface IInventory {
    + GetInfo(): string
    + AddItem(item: IItem): void
    + RemoveItem(item: IItem): void
  }

  class PlayerInventory {
    - left_hand: IItem
    - right_hand: IItem
    - body: IItem
    - backpack: IItem[]
    + PlayerInventory()
    + AddItem(item: IItem): void
    + RemoveItem(item: IItem): void
    + GetInfo(): string
  }

  class ItemGenerator {
    + GenerateItem(): IItem
  }
}

package "UI & Logic" {
  interface ICommand {
    + CommandExecute(): void
  }

  class DefaultLogic {
    - commands: Map<string, ICommand>
    + DoCommand(console_command: string): void
    + AddCommand(command_name: string, command: ICommand): void
  }

  class LogicHandler {
    - LogicHandlerInstance: LogicHandler
    + GetInstance(): LogicHandler
    + CurrentLogic: DefaultLogic
    + ChangeLogic(new_logic: DefaultLogic): void
  }

  class GlobalLogic {
  }

  class MainMenuLogic {
    - MainMenuLogicInstance: MainMenuLogic
    + GetInstance(): MainMenuLogic
  }

  class TownLogic {
    - TownLogicInstance: TownLogic
    + GetInstance(): TownLogic
  }

  class ShopLogic {
    - ShopLogicInstance: ShopLogic
    + GetInstance(): ShopLogic
  }

  class FightLogic {
    - MainFightLogicInstance: FightLogic
    + GetInstance(): FightLogic
  }

  class NewGame {
    + CommandExecute(): void
  }

  class ExploreCommand {
    + CommandExecute(): void
  }

  class OpenShopCommand {
    + CommandExecute(): void
  }

  class ShowInventoryCommand {
    + CommandExecute(): void
  }

  class ShowCommansList {
    + CommandExecute(): void
  }

  class Exit {
    + CommandExecute(): void
  }
}

package "Locations" {
    enum LocationType {
        DESERT
        FOREST
        FIELD
        LOCATION_TYPE_COUNT
    }

    enum WeatherType {
        RAIN
        SUN
        SNOW
        WEATHER_TYPE_COUNT
    }

    class Locations {
        - type: LocationType
        - weather: WeatherType
        - properties: string[]
        + Locations(type: LocationType, weater: WeatherType)
        + AddProperty(property: string): void
        + GetType(): LocationType
        + GetWeather(): WeatherType
        + GetProperties(): string[]
        + HasProperty(property: string): bool
        + DisplayInfo(): void
    }

    class LocationGenerator {
        + GenerateLocation(): Locations
    }
}

package "Game Initialization" {
  class GameInitialisation {
    + StartGame(): void
  }
}

' Relationships

' Game Core
GameMaster "1" -- "1" Director : has
GameMaster "1" -- "*" DefaultLogic : manages
GameMaster "1" -- "1" Player : manages
CommandHandler "1" -- "1" GameMaster : uses

' Characters & NPCs
Character <|-- Player
Character <|-- NPC
Character <|-- Enemy
NPC <|-- Merchant
EnemyFactory "1" -- "*" Enemy : creates
Player "1" -- "1" PlayerInventory : has

' Items & Inventory
IItem <|-- Gem
IItem <|-- Weapon
IItem <|-- Armor
Weapon <|-- Sword
IInventory <|-- PlayerInventory
PlayerInventory "1" -- "*" IItem : contains
Weapon "1" -- "*" Gem : contains
Armor "1" -- "*" Gem : contains
ItemGenerator "1" -- "*" IItem : creates

' UI & Logic
ICommand <|-- NewGame
ICommand <|-- ExploreCommand
ICommand <|-- OpenShopCommand
ICommand <|-- ShowInventoryCommand
ICommand <|-- ShowCommansList
ICommand <|-- Exit
DefaultLogic <|-- MainMenuLogic
DefaultLogic <|-- TownLogic
DefaultLogic <|-- ShopLogic
DefaultLogic <|-- FightLogic
DefaultLogic <|-- GlobalLogic
LogicHandler "1" -- "1" DefaultLogic : manages
DefaultLogic "1" -- "*" ICommand : contains
MainMenuLogic "1" -- "*" NewGame : contains
TownLogic "1" -- "*" ExploreCommand : contains
TownLogic "1" -- "*" OpenShopCommand : contains
TownLogic "1" -- "*" ShowInventoryCommand : contains

' Locations
LocationGenerator "1" -- "*" Locations : creates

' Game Initialization
GameInitialisation "1" -- "1" GameMaster : uses

@enduml
